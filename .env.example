# Database Configuration
DATABASE_URL="file:./dev.db"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cashfree Payments (Sign up at https://www.cashfree.com/ and obtain Test/Prod API Keys)
CASHFREE_ENV="SANDBOX" # or PRODUCTION
CASHFREE_CLIENT_ID="your_cashfree_app_id"
CASHFREE_CLIENT_SECRET="your_cashfree_secret_key"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_signature_secret"

# Administrative & Auth Configuration
AUTH_SECRET="generate_a_random_32_char_hex_secret"
ADMIN_EMAIL="admin@thevichaarcouncil.in"

# Email Configuration
EMAIL_SERVER_HOST="smtp.provider.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="The Vichaar Council <noreply@thevichaarcouncil.in>"
